# Copy to .env and fill in. NEVER commit the real .env.

# --- WaterH -----------------------------------------------------------------
# Your WaterH login, plus the OAuth client credentials extracted from your own
# app traffic capture (see README "Part A"). The client_id/secret are the same
# for everyone using the app, but capture your own rather than trusting a copy.
WATERH_EMAIL=you@example.com
WATERH_PASSWORD=your-waterh-password
WATERH_CLIENT_ID=captured-client-id
WATERH_CLIENT_SECRET=captured-client-secret

# --- Garmin -----------------------------------------------------------------
# Only used by garmin_bootstrap.py's verification step; the running service
# authenticates from the saved token, not these. Safe to leave blank once
# you've bootstrapped a token.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# --- Behaviour --------------------------------------------------------------
# Local time zone: WaterH buckets intake by local day, and this is sent as a
# header. Use your IANA zone, e.g. Europe/Riga, Europe/Berlin, America/New_York.
WATERH_TZ=Europe/Riga

# Secret that guards the manual /sync endpoint. Make it long and random, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SYNC_KEY=change-me-to-a-long-random-string

# How often the built-in scheduler runs the sync (seconds). 3600 = hourly.
SYNC_INTERVAL_SECONDS=3600
